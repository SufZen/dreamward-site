---
/* The hero: a night sky over a quiet horizon, and a path of growing steps that
   draws itself up toward the north star. Mirrored on RTL pages, so the path
   still leads "forward" in the reading direction. */
import { bezier, round, starPath, starfield, type Pt } from '../lib/geom';

interface Props { rtl?: boolean }
const { rtl = false } = Astro.props;

const W = 600;
const H = 510;
const P0: Pt = [64, 452];
const P1: Pt = [230, 452];
const P2: Pt = [262, 230];
const P3: Pt = [458, 132];
const curve = `M${P0.join(' ')} C${P1.join(' ')} ${P2.join(' ')} ${P3.join(' ')}`;
const steps = [0.1, 0.25, 0.4, 0.55, 0.7, 0.83].map((t, i) => {
  const [x, y] = bezier(P0, P1, P2, P3, t);
  return { x, y, r: round(3 + i * 1.15), d: `${round(0.5 + i * 0.28)}s` };
});
const stars = starfield(7, 78, W, 380);
const flip = rtl ? `translate(${W} 0) scale(-1 1)` : undefined;
---
<svg viewBox={`0 0 ${W} ${H}`} role="presentation" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="hero-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffcc00" stop-opacity="0.45" />
      <stop offset="45%" stop-color="#ffcc00" stop-opacity="0.1" />
      <stop offset="100%" stop-color="#ffcc00" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="hero-horizon" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffcc00" stop-opacity="0.18" />
      <stop offset="100%" stop-color="#ffcc00" stop-opacity="0" />
    </linearGradient>
    <linearGradient id="hero-path" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0%" stop-color="#ffcc00" stop-opacity="0.15" />
      <stop offset="100%" stop-color="#ffcc00" stop-opacity="0.85" />
    </linearGradient>
  </defs>

  <g fill="#ececf1">
    {stars.map((s) => (
      <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} class={s.twinkle ? 'twinkle' : undefined} style={s.twinkle ? `animation-delay:${s.delay}s` : undefined} />
    ))}
  </g>

  <g transform={flip}>
    <!-- horizon and hills -->
    <path d="M0 470 Q300 432 600 470 L600 510 L0 510 Z" fill="url(#hero-horizon)" />
    <path d="M0 482 L70 452 L130 470 L205 440 L290 474 L360 448 L440 476 L520 455 L600 470 L600 510 L0 510 Z" fill="#0e0e15" stroke="rgba(255,255,255,0.08)" />
    <!-- the path -->
    <path d={curve} fill="none" stroke="url(#hero-path)" stroke-width="1.5" stroke-linecap="round" class="draw" style="--len:640" />
    {steps.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#ffcc00" class="pop" style={`--d:${s.d}`} />)}
    <!-- the north star -->
    <circle cx={P3[0] + 6} cy={P3[1] - 22} r="96" fill="url(#hero-glow)" class="pulse" />
    <path d={starPath(P3[0] + 6, P3[1] - 22, 46)} fill="#ffcc00" class="glow-star pop" style="--d:2.2s" />
    <!-- where you are now -->
    <circle cx={P0[0]} cy={P0[1]} r="9" fill="none" stroke="#ffcc00" stroke-opacity="0.5" />
    <circle cx={P0[0]} cy={P0[1]} r="2.5" fill="#ffcc00" />
  </g>
</svg>
