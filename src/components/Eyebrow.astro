---
/* Section label with its step dot: each section is one more step, so it grows. */
interface Props { step: number; text: string }
const { step, text } = Astro.props;
const size = 5 + step * 1.2;
---
<p class="eyebrow"><span class="dot" style={`width:${size}px;height:${size}px`} aria-hidden="true"></span>{text}</p>
